# The throwaway Instance Connect key pair and the socket of the EC2 instance's Docker daemon.
/scripts/lib/.ssh/
.env
.env.*
# The registered A2A callers and their secrets, written by scripts/tools/register-caller.sh.
/allowed-callers.yaml
docs/superpowers/*
.claude/
CLAUDE.local.md
.superpowers/

# Card statements are private and stay local; the folder itself is tracked.
statements/*
!statements/.gitkeep

# Local copies of a previous .env and registry, kept for reference; never committed.
backup/
