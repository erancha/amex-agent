# Copy to .env and fill in, or run ./scripts/init-env.sh, which copies this file and mints
# APP_A2A_TOKEN. Each key is tagged:
#   REQUIRED — the agent refuses to start without it.
#   AUTO     — filled by scripts/init-env.sh.
#   OPTIONAL — a default applies when blank.
# The scripts treat these values as defaults: a variable already exported in the calling shell
# wins over the same key here.

# ── Agent ────────────────────────────────────────────────────────────────────────
# OPTIONAL — port the agent listens on (default 8020). Under Docker it is only the host port; the
# container always listens on 8020. When you change it, change APP_AGENT_URL to match.
SERVER_PORT=8020
# OPTIONAL — URL clients reach the agent at; published in the Agent Card. The A2A client calls
# this URL, not the one it fetched the card from, so it must carry the port above, and inside
# Docker Compose it must be the service address (the home finance agent's compose file sets it).
APP_AGENT_URL=http://localhost:8020
# REQUIRED — folder holding the monthly statements downloaded from the card site (<YYYY>-<MM>.pdf;
# Excel exports are read too). It starts empty; the statements page (/statements.html) loads
# PDFs into it, and the tests read their own statement under src/test/resources/statements.
APP_STATEMENTS_DIR=./statements

# ── Access ───────────────────────────────────────────────────────────────────────
# OPTIONAL — require "Authorization: Bearer <APP_A2A_TOKEN>" on A2A calls (default true). The
# card, /actuator/health and the statements page with its API are always open.
# validate.sh --tck runs with it off.
APP_A2A_AUTH_REQUIRED=true
# AUTO — the shared bearer token; the home finance agent's init-env.sh copies it into its .env.
APP_A2A_TOKEN=

# ── Categorization ───────────────────────────────────────────────────────────────
# REQUIRED — the language model provider that categorizes merchants: anthropic | openai.
APP_LLM_PROVIDER=anthropic
# REQUIRED — the provider's model id, e.g. claude-haiku-5-5 or gpt-5-mini.
APP_LLM_MODEL=
# REQUIRED for APP_LLM_PROVIDER=anthropic — the agent refuses to start without it.
ANTHROPIC_API_KEY=
# REQUIRED for APP_LLM_PROVIDER=openai — the agent refuses to start without it.
OPENAI_API_KEY=
# OPTIONAL — the model's score (0 to 1) from which a row's confidence is reported as "high"
# (default 0.85) and as "medium" (default 0.6); below the medium one it is "low".
APP_CATEGORIZER_HIGH_CONFIDENCE=0.85
APP_CATEGORIZER_MEDIUM_CONFIDENCE=0.6
# OPTIONAL — how many not-yet-seen merchants go to the model in one call (default 40).
APP_CATEGORIZER_BATCH_SIZE=40

# ── Logging ──────────────────────────────────────────────────────────────────────
# OPTIONAL — level for com.erancha (default INFO) and for the A2A SDK (default WARN).
# LOG_LEVEL=DEBUG
# A2A_LOG_LEVEL=DEBUG
