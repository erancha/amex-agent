# Copy to .env and fill in, or run ./scripts/init-env.sh, which copies this file. Each key is
# tagged:
#   REQUIRED  — the agent refuses to start without it.
#   OPTIONAL  — a default applies when blank.
#   TEST-ONLY — leave unset; the tests and validate.sh set it.
# The scripts treat these values as defaults: a variable already exported in the calling shell
# wins over the same key here.

# ── Agent ────────────────────────────────────────────────────────────────────────
# OPTIONAL — port the agent listens on (default 8020). Under Docker it is only the host port; the
# container always listens on 8020. When you change it, change APP_AGENT_URL to match.
SERVER_PORT=8020
# OPTIONAL — the URL callers reach the agent at, published in the Agent Card; an A2A client calls
# this URL, not the one it fetched the card from, so it must carry the port above. A caller running
# in Docker on this machine reaches the agent as http://host.docker.internal:8020; a caller
# elsewhere by this machine's hostname. Hand it to each caller's operator with their secret.
APP_AGENT_URL=http://localhost:8020
# REQUIRED — root of the statement folders, one sub-folder per person named by their Google
# account id, holding the monthly statements downloaded from the card site (<YYYY>-<MM>.pdf; Excel
# exports are read too). It starts empty; the statements page (/statements.html) loads PDFs into
# the signed-in person's folder, and the tests read their own statement under
# src/test/resources/statements.
APP_STATEMENTS_DIR=./statements

# ── Access ───────────────────────────────────────────────────────────────────────
# OPTIONAL — require credentials (default true): every A2A call carries the signed-in person's
# Google ID token as the bearer token and a registered caller's secret in X-Caller-Secret, and
# the statements API needs the person's token. The card, /actuator/health, the statements page and
# /api/auth/config are always open. validate.sh --tck runs with it off; then there is one person,
# "anonymous", and no token or secret is read.
APP_A2A_AUTH_REQUIRED=true
# REQUIRED while access is required — this agent's own Google OAuth client id (a "Web application"
# client in its own Google Cloud project, with this agent's origin as an authorized JavaScript
# origin). The statements page signs in with it, and tokens sent to that page must be issued to it.
APP_AUTH_CLIENT_ID=
# OPTIONAL — the file registering the A2A callers (default ./allowed-callers.yaml beside .env),
# written by ./scripts/register-caller.sh: for each caller its name, the secret it presents and the
# Google OAuth client id whose tokens it forwards. Docker mounts it at /allowed-callers.yaml.
# APP_A2A_CALLERS_FILE=./allowed-callers.yaml
# OPTIONAL — who issues the tokens and where its public keys are published. The defaults are
# Google's; both are read only when a token is verified.
# APP_AUTH_ISSUER=https://accounts.google.com
# APP_AUTH_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# TEST-ONLY — a PEM public key that replaces APP_AUTH_JWKS_URL, so tests can sign their own tokens.
# APP_AUTH_PUBLIC_KEY_FILE=

# ── Categorization ───────────────────────────────────────────────────────────────
# REQUIRED — provider:model, anthropic or openai. Classifying merchants with a usable confidence
# score wants the Haiku or mini tier, not the smallest one: anthropic:claude-haiku-5-5 or
# openai:gpt-5-mini.
APP_LLM_MODEL=anthropic:claude-haiku-5-5
# REQUIRED — the API key of the provider APP_LLM_MODEL names; the agent refuses to start
# without it.
APP_LLM_API_KEY=
# OPTIONAL — the model's score (0 to 1) from which a row's confidence is reported as "high"
# (default 0.85) and as "medium" (default 0.6); below the medium one it is "low".
APP_CATEGORIZER_HIGH_CONFIDENCE=0.85
APP_CATEGORIZER_MEDIUM_CONFIDENCE=0.6
# OPTIONAL — how many not-yet-seen merchants go to the model in one call (default 40).
APP_CATEGORIZER_BATCH_SIZE=40

# ── Logging ──────────────────────────────────────────────────────────────────────
# OPTIONAL — level for com.erancha (default INFO) and for the A2A SDK (default WARN).
# LOG_LEVEL=DEBUG
# A2A_LOG_LEVEL=DEBUG
